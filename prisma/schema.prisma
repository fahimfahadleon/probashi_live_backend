// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id         String     @id @unique
  name       String
  profilePic String
  bio        String?
  coin       Int        @default(0)
  diamond    Int        @default(0)
  level      Int        @default(1)
  vipStatus  Boolean    @default(false)
  badge      String?
  settings   Json?
  extra      Json?
  isBlocked  Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  liveUsers  LiveUser[]

  payments                  Payment[]
  paymentHistory            PaymentHistory[]
  sentMessages              Message[]                   @relation("SentMessages")
  receivedMessages          Message[]                   @relation("ReceivedMessages")
  collectionPurchaseHistory CollectionPurchaseHistory[]

  // CoinSeller relations
  coinSeller          CoinSeller?
  receivedCoinHistory CoinSendHistory[]  @relation("UserReceivedCoins")
  coinSellerRequest   CoinSellerRequest?

  relationshipsFrom Relationship[] @relation("UserFrom")
  relationshipsTo   Relationship[] @relation("UserTo")

  // 🔹 New report relations
  reportsMade     UserReport[] @relation("ReportsMade") // reports submitted by this user
  reportsReceived UserReport[] @relation("ReportsReceived") // reports targeting this user
}

model Relationship {
  id         String           @id @default(uuid())
  fromUserId String
  toUserId   String
  type       RelationshipType @default(FOLLOW)
  createdAt  DateTime         @default(now())

  fromUser User @relation("UserFrom", fields: [fromUserId], references: [id])
  toUser   User @relation("UserTo", fields: [toUserId], references: [id])

  @@unique([fromUserId, toUserId])
}

enum RelationshipType {
  FOLLOW
  FRIEND
}

model UserReport {
  id         String       @id @default(cuid())
  reporterId String? // user who is submitting the report (optional for anonymous)
  targetId   String? // user who is being reported (can be null if reporting a non-user entity)
  email      String
  reason     String
  status     ReportStatus @default(PENDING) // workflow status
  reviewedBy String? // admin ID who handled it
  reviewedAt DateTime? // when admin reviewed it
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  // Relations
  reporter User? @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: SetNull)
  target   User? @relation("ReportsReceived", fields: [targetId], references: [id], onDelete: SetNull)
}

enum ReportStatus {
  PENDING
  REVIEWED
  REJECTED
}

model Settings {
  id           Int   @id @default(1) // always one row
  profitMargin Float @default(0)
  gateways     Json  @default("[]")
  appSettings  Json  @default("{\"maintenanceMode\": false, \"showAds\": true, \"forceUpdate\": false}")
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  content    String
  createdAt  DateTime @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id])
}

model Product {
  id        String      @id @default(cuid())
  type      ProductType
  vipPackId String?     @unique
  offerId   String?     @unique

  vipPack VIPDiamondPack? @relation(fields: [vipPackId], references: [id])
  offer   Offer?          @relation(fields: [offerId], references: [id])
  Payment Payment[]
}

enum ProductType {
  VIP_PACK
  OFFER
  // Add more later: SUBSCRIPTION, BUNDLE, etc.
}

model VIPDiamondPack {
  id        String   @id @default(cuid())
  price     Float
  diamonds  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[] // 👈 This line establishes the reverse relation
  Product  Product?
}

model Payment {
  id            String        @id @default(cuid())
  transactionId String        @unique
  method        String
  status        PaymentStatus @default(PENDING)
  userId        String
  productId     String
  description   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user             User             @relation(fields: [userId], references: [id])
  product          Product          @relation(fields: [productId], references: [id])
  histories        PaymentHistory[]
  VIPDiamondPack   VIPDiamondPack?  @relation(fields: [vIPDiamondPackId], references: [id])
  vIPDiamondPackId String?
}

model PaymentHistory {
  id          String           @id @default(cuid())
  paymentId   String
  userId      String
  diamonds    Int? // nullable because not all products give diamonds
  price       Float // record the price at time of purchase
  eventType   HistoryEventType
  description String?
  createdAt   DateTime         @default(now())

  user    User    @relation(fields: [userId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

enum HistoryEventType {
  CREATED
  APPROVED
  DECLINED
  REFUND
  DELIVERY
}

enum PaymentStatus {
  PENDING
  APPROVED
  DECLINED
}

model Offer {
  id        String   @id @default(cuid())
  title     String
  content   String // can be diamond count, text, or a URL
  price     Float
  diamonds  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Product   Product?
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LiveSession {
  id String @id @default(cuid())

  // Two separate relations with aliases
  hosts        LiveUser[] @relation("LiveSessionHosts")
  participants LiveUser[] @relation("LiveSessionParticipants")
  audience     LiveUser[] @relation("LiveSessionAudience")

  comments LiveComment[] @relation("SessionComments")
  gifts    LiveGift[]    @relation("SessionGifts")

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LiveUser {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  // Separate session relations to avoid conflict
  hostSession   LiveSession? @relation("LiveSessionHosts", fields: [hostSessionId], references: [id])
  hostSessionId String?

  participantSession   LiveSession? @relation("LiveSessionParticipants", fields: [participantSessionId], references: [id])
  participantSessionId String?

  isHost Boolean @default(false)

  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  comments      LiveComment[]
  giftsSent     LiveGift[]    @relation("GiftsSent")
  giftsReceived LiveGift[]    @relation("GiftsReceived")

  audienceSession   LiveSession? @relation("LiveSessionAudience", fields: [audienceSessionId], references: [id])
  audienceSessionId String?

  role String @default("participant")
}

model LiveGift {
  id String @id @default(cuid())

  fromUser   LiveUser @relation("GiftsSent", fields: [fromUserId], references: [id])
  fromUserId String

  toUser   LiveUser @relation("GiftsReceived", fields: [toUserId], references: [id])
  toUserId String

  session   LiveSession @relation("SessionGifts", fields: [sessionId], references: [id])
  sessionId String

  giftId    String
  createdAt DateTime @default(now())
}

model LiveComment {
  id String @id @default(cuid())

  liveUser   LiveUser @relation(fields: [liveUserId], references: [id])
  liveUserId String

  session   LiveSession @relation("SessionComments", fields: [sessionId], references: [id])
  sessionId String

  message   String
  createdAt DateTime @default(now())
}

model GiftCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gifts Gift[]
}

model Gift {
  id           String   @id @default(cuid())
  name         String
  imageUrl     String // SVGA URL served by backend
  thumbnailUrl String // Now required (not nullable)
  price        Int
  categoryId   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category GiftCategory @relation(fields: [categoryId], references: [id])
}

model CollectionsCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collections Collections[]
}

model Collections {
  id           String   @id @default(cuid())
  name         String   @unique
  imageUrl     String // SVGA URL served by backend
  thumbnailUrl String // Now required (not nullable)
  price        Int
  categoryId   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category CollectionsCategory @relation(fields: [categoryId], references: [id])
}

model CollectionPurchaseHistory {
  id        String   @id @default(cuid())
  userId    String
  type      String // 'frame', 'bubble', 'entrance', etc.
  name      String // name of the collection item purchased
  price     Int // price in diamonds
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model CoinSeller {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName    String
  status      String @default("active")
  nationalId  String @unique
  phoneNumber String @unique
  email       String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  coinSendHistory CoinSendHistory[]
}

model CoinSendHistory {
  id String @id @default(cuid())

  fromSellerId String
  fromSeller   CoinSeller @relation(fields: [fromSellerId], references: [id], onDelete: Cascade)

  toUserId String
  toUser   User   @relation("UserReceivedCoins", fields: [toUserId], references: [id], onDelete: Cascade)

  amount    Int
  createdAt DateTime @default(now())
}

model CoinSellerRequest {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName    String
  nationalId  String
  phoneNumber String
  email       String

  status     RequestStatus @default(PENDING)
  reviewedBy String? // Admin user ID (if applicable)
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}
